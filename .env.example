# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cold_chain
DB_USER=root
DB_PASSWORD=

# LLM / LangChain
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Cold Chain Control Center
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cold-chain

# Weather provider (Open-Meteo defaults are used when blank)
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_HISTORICAL_URL=https://archive-api.open-meteo.com/v1/archive

# Simulator
SIMULATION_INTERVAL_SECONDS=20
SIMULATOR_REFRIGERATION_FAILURE_AFTER_STEPS=-1
DEFAULT_TRUCK_ID=TRUCK_001
DEFAULT_TRIP_ID=TRIP_001
DEFAULT_ROUTE_ID=route_001
SOP_VECTOR_DB_PATH=sop/chroma_db
WEATHER_CACHE_KM_TOLERANCE=10.0
WEATHER_CACHE_MINUTES_TOLERANCE=60.0
